#!/usr/bin/env python3
# Fake terminal window (`open file.command` on macOS, $TERMINAL -e sh file on Linux): runs the
# script on a pseudo-terminal, typing FAKE_TERMINAL_TYPED plus Enter once FAKE_TERMINAL_WAIT shows.
# FAKE_TERMINAL_CLOSE: the window is closed when the prompt shows. FAKE_TERMINAL_LOG gets what it showed.
import os, pty, select, signal, sys, time
wait = os.environ.get("FAKE_TERMINAL_WAIT", "\0").encode()
pid, fd = pty.fork()
if pid == 0:
    os.execvp("sh", ["sh", sys.argv[-1]])
out, typed, deadline = b"", False, time.time() + 30
while True:
    if not select.select([fd], [], [], max(0, deadline - time.time()))[0]:
        os.kill(pid, signal.SIGKILL)
        break
    try:
        chunk = os.read(fd, 4096)
    except OSError:
        break
    if not chunk:
        break
    out += chunk
    if not typed and wait in out:
        typed = True
        if os.environ.get("FAKE_TERMINAL_CLOSE"):
            os.kill(pid, signal.SIGKILL)
            break
        os.write(fd, os.environ.get("FAKE_TERMINAL_TYPED", "").encode() + b"\r")
log = os.environ.get("FAKE_TERMINAL_LOG")
if log:
    open(log, "ab").write(out)
