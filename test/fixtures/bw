#!/usr/bin/env node
// Fake Bitwarden CLI for tests. State lives in $FAKE_BW_VAULT (JSON), or in
// $BITWARDENCLI_APPDATA_DIR/fake-vault.json for a separate login (an account
// with its own "password" and "session"); every invocation is appended to
// $FAKE_BW_LOG so tests can count spawns.
import fs from "node:fs";
const appdata = process.env.BITWARDENCLI_APPDATA_DIR;
const vaultPath = appdata ? `${appdata}/fake-vault.json` : process.env.FAKE_BW_VAULT;
const args = process.argv.slice(2);
if (process.env.FAKE_BW_LOG) fs.appendFileSync(process.env.FAKE_BW_LOG, `${appdata ? "[own] " : ""}${args.join(" ")}\n`);
const state = fs.existsSync(vaultPath) ? JSON.parse(fs.readFileSync(vaultPath, "utf8")) : { status: "unauthenticated", items: [] };
const save = () => fs.writeFileSync(vaultPath, JSON.stringify(state));
const out = (value) => process.stdout.write(typeof value === "string" ? value : JSON.stringify(value));
const die = (message) => { process.stderr.write(message); process.exit(1); };
const session = state.session ?? "fake-session";
const unlocked = () => state.status === "unlocked" && process.env.BW_SESSION === session;
const find = (key) => {
  const byId = state.items.filter((item) => item.id === key);
  if (byId.length) return byId[0];
  const matches = state.items.filter((item) => item.name.toLowerCase() === key.toLowerCase());
  if (matches.length > 1) die("More than one result was found. Try getting a specific object by `id` instead.");
  if (!matches.length) die("Not found.");
  return matches[0];
};
const stdin = () => { try { return fs.readFileSync(0, "utf8"); } catch { return ""; } };
// bw 2026.9+ against Vaultwarden before 1.37.4: the login is saved, then a
// follow-up call gets a 404 and bw exits 1 without printing a session.
const backfill = () => die("ERROR bitwarden_user_crypto_management::key_id_backfill: Failed to post the user key id: 404\nError [KeyIdBackfillError]: API call failed during user key id backfill");
const [cmd, sub, key] = args;
if (cmd === "--version") out("2026.1.0\n");
else if (cmd === "status") out({ serverUrl: state.server ?? "https://vault.example.test", ...(state.email ? { userEmail: state.email } : {}), status: unlocked() ? "unlocked" : state.status === "unauthenticated" ? "unauthenticated" : "locked" });
else if (cmd === "config" && sub === "server") { fs.mkdirSync(appdata, { recursive: true }); fs.writeFileSync(`${appdata}/data.json`, "{}"); state.server = key; save(); out("Saved setting `config`."); }
else if (cmd === "unlock") {
  if (process.env.BW_PASSWORD !== (state.password ?? "master")) die("Invalid master password.");
  // A newer bw's first unlock of an older bw's data runs a migration that can fail.
  if (process.env.FAKE_BW_MIGRATION_ERROR && !state.migrated) { state.migrated = true; save(); die("[Encrypted Migrator] Error running migrations for user: u1 Error [KeyIdBackfillError]: API call failed during user key id backfill"); }
  state.status = "unlocked"; save(); out(session);
}
else if (cmd === "login" && sub === "--apikey") { state.status = "locked"; save(); if (process.env.FAKE_BW_BACKFILL_ERROR) backfill(); out("logged in"); }
else if (cmd === "login") {
  if (state.registered !== sub || process.env.BW_PASSWORD !== state.password) die("Username or password is incorrect. Try again.");
  state.email = sub;
  if (process.env.FAKE_BW_BACKFILL_ERROR) { state.status = "locked"; save(); backfill(); }
  state.status = "unlocked"; save(); out(session);
}
else if (cmd === "sync") {
  // Like the real bw, a refresh token the server rejects ends the login.
  if (process.env.FAKE_BW_SYNC_ERROR) { state.status = "unauthenticated"; save(); die(process.env.FAKE_BW_SYNC_ERROR); }
  // A slow sync marks itself, so a test can see two syncs running at once.
  const marker = `${vaultPath}.syncing`;
  if (fs.existsSync(marker)) fs.writeFileSync(`${vaultPath}.overlap`, "");
  fs.writeFileSync(marker, "");
  const end = Date.now() + Number(process.env.FAKE_BW_SYNC_MS ?? 0);
  while (Date.now() < end) {}
  fs.rmSync(marker, { force: true });
  out("");
}
else if (cmd === "lock") { state.status = "locked"; save(); out("Your vault is locked."); }
// Like the real bw, a locked vault waits on a master-password prompt unless BW_NOINTERACTION is set.
else if (!unlocked() && process.env.FAKE_BW_PROMPT && process.env.BW_NOINTERACTION !== "true") setInterval(() => {}, 1000);
else if (state.status === "unauthenticated") die("You are not logged in.");
else if (!unlocked()) die("Vault is locked.");
else if (cmd === "list" && sub === "items") {
  const search = args[3] ?? "";
  out(state.items.filter((item) => item.name.toLowerCase().includes(search.toLowerCase())));
} else if (cmd === "get" && sub === "item") out(find(key));
else if (cmd === "get" && sub === "password") { const item = find(key); if (!item.login?.password) die("No password available."); out(item.login.password); }
else if (cmd === "get" && sub === "totp") out("123456");
else if (cmd === "create" && sub === "item") {
  const item = JSON.parse(Buffer.from(stdin(), "base64").toString("utf8"));
  if (item.name === process.env.FAKE_BW_FAIL_CREATE) die("Simulated create failure.");
  item.id = `id-${state.items.length + 1}`; state.items.push(item); save(); out(item);
} else if (cmd === "edit" && sub === "item") {
  const item = JSON.parse(Buffer.from(stdin(), "base64").toString("utf8"));
  state.items = state.items.map((existing) => (existing.id === key ? item : existing)); save(); out(item);
} else if (cmd === "delete" && sub === "item") { state.items = state.items.filter((item) => item.id !== key); save(); }
else die(`fake bw: unsupported ${args.join(" ")}`);
