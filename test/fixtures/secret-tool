#!/bin/sh
# Fake Linux secret-tool: `store` saves stdin to $FAKE_KEYCHAIN_DIR/<service>;
# lookups are answered by the fake `security`, which readKeychain tries first.
[ "$1" = "store" ] || exit 1
service=""
while [ $# -gt 0 ]; do [ "$1" = "service" ] && service="$2"; shift; done
IFS= read -r value || [ -n "$value" ] || exit 1
printf '%s\n' "$value" > "$FAKE_KEYCHAIN_DIR/$service"
