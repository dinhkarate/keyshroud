#!/bin/sh
# Fake Linux secret-tool: `store` saves stdin to $FAKE_KEYCHAIN_DIR/<service> and `clear`
# removes it; lookups are answered by the fake `security`, which readKeychain tries first.
op="$1"
service=""
while [ $# -gt 0 ]; do [ "$1" = "service" ] && service="$2"; shift; done
if [ "$op" = "clear" ]; then rm -f "$FAKE_KEYCHAIN_DIR/$service"; exit 0; fi
[ "$op" = "store" ] || exit 1
IFS= read -r value || [ -n "$value" ] || exit 1
[ -n "$FAKE_KEYCHAIN_GARBLE" ] && value="garbled"
printf '%s\n' "$value" > "$FAKE_KEYCHAIN_DIR/$service"
