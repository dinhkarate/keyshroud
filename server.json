{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dinhkarate/keyshroud",
  "title": "keyshroud",
  "description": "Agent-safe secrets (local encrypted vault or Vaultwarden): injected into commands, masked in output",
  "repository": {
    "url": "https://github.com/dinhkarate/keyshroud",
    "source": "github"
  },
  "websiteUrl": "https://keyshroud.dev",
  "version": "0.9.5",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "keyshroud",
      "version": "0.9.5",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
